# --- required -------------------------------------------------------------
# Password for the web UI
APP_PASSWORD=change-me

# --- optional -------------------------------------------------------------
# Signs the login cookie. If empty a random key is generated once and stored in /data/.secret_key
SECRET_KEY=
# Time zone for the times shown in the UI (e.g. Europe/Prague)
TZ=UTC
# Sign-in by a reverse proxy (Authelia, Authentik, oauth2-proxy...): the header carrying the signed-in user and
# the proxy's addresses / networks. The header is only trusted from those addresses. Both needed; with them,
# APP_PASSWORD may be left empty (then the app can only be used through the proxy). Trust only the proxy's own
# address (see README), and don't set FORWARDED_ALLOW_IPS.
AUTH_HEADER=
TRUSTED_PROXIES=

# --- optional first-start seeds -------------------------------------------
# These only pre-fill the Settings page the first time the app starts.
# After that the values saved in the UI win and changing them here has no effect.
LIDARR_URL=
LIDARR_API_KEY=
LIDARR_ROOT=
LIDARR_QUALITY=
LIDARR_METADATA=
JELLYFIN_URL=
JELLYFIN_API_KEY=
JELLYFIN_USER=
# 0 = don't set the YouTube cover as the Jellyfin playlist image
JELLYFIN_COVER=1
# The Lidarr address your browser uses, for Search in Lidarr links (empty = LIDARR_URL)
LIDARR_LINK_URL=
DEFAULT_INTERVAL_HOURS=24
